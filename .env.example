###############################################################################
# HelperBot Pro v7 — .env.example
# Скопируй этот файл как `.env` и подставь свои значения.
# В значениях НЕ используй кавычки, комментарии ставь только на отдельных строках.
###############################################################################

# ───────────────────────────────
# ⚙️  Minecraft сервер
# ───────────────────────────────
# IP/домен сервера (для одиночки: localhost)
SERVER_HOST=localhost
# Порт сервера (по умолчанию 25565)
SERVER_PORT=25565
# Имя бота (при AUTO_NAME=true добавит _1, _2 при конфликте)
BOT_NAME=HelperBot
# Версия клиента — должна совпадать с сервером
VERSION=1.21.4
# Авторизация: offline | microsoft
AUTH=offline

# ───────────────────────────────
# 🌍  Веб-viewer (онлайн карта)
# ───────────────────────────────
# Порт веб-визуализатора (должен быть свободен)
VIEWER_PORT=3007

# ───────────────────────────────
# 🤖  Telegram интеграция
# ───────────────────────────────
# Токен от @BotFather
TG_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# ID чата/канала для сообщений (например: -1001234567890)
TG_CHAT_ID=YOUR_PUBLIC_CHANNEL_OR_CHAT_ID
# Telegram ID владельца (для приватных команд)
TG_OWNER_ID=123456789

# ───────────────────────────────
# 🔒  Безопасность
# ───────────────────────────────
# Пароль для критичных команд (/reset, /stop и т.п.) — замени в реальном .env!
ADMIN_PASSWORD=WAFFLE_POWER_9001

# ───────────────────────────────
# 🔁  Переподключения и имя
# ───────────────────────────────
# Автодобавление суффикса при duplicate_login
AUTO_NAME=true
# Задержка между попытками переподключения (мс)
RECONNECT_DELAY=5000
# Максимум попыток переподключения за запуск
MAX_RECONNECT_ATTEMPTS=5

# ───────────────────────────────
# 🌿  Адаптация под окружение
# ───────────────────────────────
# Главный тумблер адаптации (биомы/ночь/опасности/свет)
ENV_AWARE=true
# Разрешить короткие “человечные” реплики в общий чат
ENV_CHAT=true
# Радиус обнаружения воды/лавы (блоков)
ENV_HAZARD_RADIUS=6
# Ставить факелы ночью при темноте
ENV_TORCH_PLACE=true
# Кулдаун между установками факелов (мс)
ENV_TORCH_COOLDOWN=10000
# Тик начала ночи (майнкрафтовые тики, ночь ≈ от 12000)
ENV_NIGHT_START_TICK=12000

# ───────────────────────────────
# ⛈️  Реакции на погоду
# ───────────────────────────────
# Комментарии о погоде (если модуль активирован)
ENV_WEATHER_CHAT=true
# Частота проверки погоды (мс)
ENV_WEATHER_SCAN_MS=4000
# Минимальный интервал между репликами о погоде (мс)
ENV_WEATHER_MSG_COOLDOWN=60000

# ───────────────────────────────
# 🧠  “AI-мозг” — редкие естественные реплики и короткая память
# ───────────────────────────────
# Включить модуль мозга
BRAIN_ENABLED=true
# Вероятность “комментария” на событие (0.0–1.0)
BRAIN_CHAT_CHANCE=0.15
# Минимальный зазор между фразами (мс) — чтобы не болтал как скрипт
BRAIN_MIN_GAP_MS=18000
# Периодичность проверки “ничегонеделания” (мс)
BRAIN_IDLE_CHECK_MS=12000
# Время “памяти” последних событий (мс)
BRAIN_MEMORY_MS=90000
# Лимит токенов фраз (боремся с болтливостью)
BRAIN_TOKENS=3
# Время восстановления одного токена (мс)
BRAIN_REFILL_MS=15000
# Радиус приветствия игроков (в блоках)
BRAIN_GREET_RADIUS=4.5
# Кулдаун на приветствие (мс)
BRAIN_GREET_COOLDOWN_MS=120000
# Кулдаун на “ай, больно!” при ударе (мс)
BRAIN_PAIN_COOLDOWN_MS=25000
# ===============================
# ?? Combat AI
# ===============================
# Use experimental advanced combat (true) or stable basic guard (false)
COMBAT_ADVANCED=false


###############################################################################
# Ввод команд и обращение  
###############################################################################

# Где принимать команды: both | telegram | minecraft
COMMANDS_INPUT=both

# Разрешить текстовые команды в Telegram без слэша
TG_TEXT_COMMANDS=true

# Требовать слово-обращение в начале (безопаснее): true|false
CHAT_REQUIRE_MENTION=false

# Слова-обращения (через запятую)
CHAT_MENTION_WORDS=бот,ботик,помощник,хай,bot,helperbot,hb,helper

# Префикс для команд в чате Minecraft
CHAT_PREFIX=!
CHAT_RESP_CHANCE=0.65
CHAT_RESP_COOLDOWN_MS=4500
COMBAT_CHATTER_CHANCE=0.5
COMBAT_CHATTER_COOLDOWN_MS=3200

# Автоповедение ИИ (экспериментально)
AI_AUTO_POLICY=false

# Владелец бота (для особых реакций)
OWNER_NAME=ТвойНик

