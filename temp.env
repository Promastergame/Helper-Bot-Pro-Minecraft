# ===============================
# ⚙️ Настройки Minecraft сервера
# ===============================
SERVER_HOST=localhost
SERVER_PORT=61773
BOT_NAME=HelperBot
VERSION=1.20.1
AUTH=offline

# ===============================
# 🌍 Viewer (онлайн карта мира)
# ===============================
VIEWER_PORT=0

# ===============================
# 🤖 Telegram интеграция
# ===============================
TG_TOKEN=ВСТАВЬ_НОВЫЙ_ТОКЕН_ТУТ
TG_CHAT_ID=6801320188
TG_OWNER_ID=6801320188

# ===================================
# 🔒 Безопасность и администрирование
# ===================================
ADMIN_PASSWORD=ПОСТАВЬ_НОВЫЙ_ПАРОЛЬ

# ===============================
# 🧠 Поведение и переподключения
# ===============================
AUTO_NAME=true
RECONNECT_DELAY=5000
MAX_RECONNECT_ATTEMPTS=5

# ===============================
# 🌿 Адаптация под окружение
# ===============================
ENV_AWARE=true
ENV_CHAT=true
ENV_HAZARD_RADIUS=6
ENV_TORCH_PLACE=true
ENV_TORCH_COOLDOWN=10000
ENV_NIGHT_START_TICK=12000
HOSTILE_SCAN_RADIUS=36

# ===============================
# ⛈️ Реакции на погоду
# ===============================
ENV_WEATHER_CHAT=true
ENV_WEATHER_SCAN_MS=4000
ENV_WEATHER_MSG_COOLDOWN=60000

# ====================================================
# 🧠 Настройки ИИ-мозга (редкие, естественные реплики)
# ====================================================
BRAIN_ENABLED=false
BRAIN_CHAT_CHANCE=0.15
BRAIN_MIN_GAP_MS=18000
BRAIN_IDLE_CHECK_MS=12000
BRAIN_MEMORY_MS=90000
BRAIN_TOKENS=3
BRAIN_REFILL_MS=15000
BRAIN_GREET_RADIUS=4.5
BRAIN_GREET_COOLDOWN_MS=120000
BRAIN_PAIN_COOLDOWN_MS=25000
ATTACK_NEUTRAL_FALLBACK=false
COMBAT_DENY=iron_golem,villager,wandering_trader,warden
ATTACK_DENY=bee,axolotl
SMART_CHOP=true

# ===============================
# 🗣️ Команды / обращение
# ===============================
CHAT_PREFIX=!
CHAT_REQUIRE_MENTION=true
CHAT_MENTION_WORDS=бот,helper,helperbot

COMMANDS_INPUT=minecraft
TG_TEXT_COMMANDS=true
STARTUP_HELP=false
